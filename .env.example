# ==============================================================================
#                     CONQUISTASERV - FRONTEND (QUASAR/VUE)
#                           TEMPLATE DE CONFIGURAÇÃO
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para '.env':
#    cp .env.example .env
# 2. Descomente as variáveis do preset correspondente ao seu ambiente de trabalho.
#
# Observação sobre o Quasar SPA:
# As variáveis abaixo são incorporadas diretamente no bundle Javascript no momento
# da compilação ('quasar dev' ou 'quasar build').
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. METADADOS DA APLICAÇÃO
# ------------------------------------------------------------------------------
APP_NAME="ConquistaServ"
VERSION=1.0.0
PORT=8080
PROTOCOL=http


# ------------------------------------------------------------------------------
# 2. ENDPOINTS DA API & URLS BASE
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# PRESET A: Desenvolvimento Local (Frontend local consumindo Backend local)
# Use este preset se você estiver rodando tanto o frontend quanto a API no seu PC.
# ------------------------------------------------------------------------------
BASE_URL=http://localhost:8080/
API_BASE_URL=http://localhost:3006/api/

# ------------------------------------------------------------------------------
# PRESET B: Desenvolvimento Local (Frontend local consumindo Backend de Homologação)
# Use este preset se quiser rodar apenas o frontend no seu PC e consumir a API de teste.
# ------------------------------------------------------------------------------
# BASE_URL=http://localhost:8080/
# API_BASE_URL=https://hml-servconquista.brainstormlabs.online/api/

# ------------------------------------------------------------------------------
# PRESET C: Ambiente de Homologação (Staging - Configurado via CI/CD no Deploy)
# Utilizado no site: https://hml-servconquista.brainstormlabs.online/
# ------------------------------------------------------------------------------
# PROTOCOL=https
# BASE_URL=https://hml-servconquista.brainstormlabs.online/
# API_BASE_URL=https://hml-servconquista.brainstormlabs.online/api/

# ------------------------------------------------------------------------------
# PRESET D: Ambiente de Produção (Production - Configurado via CI/CD no Deploy)
# Utilizado no site oficial: https://servconquista.brainstormlabs.online/
# ------------------------------------------------------------------------------
# PROTOCOL=https
# BASE_URL=https://servconquista.brainstormlabs.online/
# API_BASE_URL=https://servconquista.brainstormlabs.online/api/
